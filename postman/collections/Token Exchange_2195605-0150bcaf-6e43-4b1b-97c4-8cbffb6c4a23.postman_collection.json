  "item": [
    {
      "name": "/Token - Grant Password",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "bb031ed0-621f-477e-9938-11130e7cce8e",
            "exec": [
              "pm.collectionVariables.clear()",
              "",
              "pm.test(\"Token gerado com sucesso\", function() {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('access_token').and.to.not.be.undefined;  ",
              "    pm.environment.set(\"access_token_sicoob\", json.access_token);",
              "    pm.environment.set(\"id_token_sicoob\", json.id_token);",
              "});",
              "",
              "function jwt_decode(jwt) {",
              "    var partes = jwt.split('.'); // header, payload, signature",
              "    return JSON.parse(atob(partes[1]));",
              "}",
              "",
              "pm.test(\"Mostra dados\", function () {  ",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    console.log(\"Chaves: \" + Object.keys(json));",
              "",
              "    pm.expect(json).to.have.property('access_token').and.to.not.be.undefined;  ",
              "    let decodificado = jwt_decode(json.access_token);",
              "    console.log(\"Access Token: \" + JSON.stringify(decodificado));",
              "",
              "    pm.expect(json).to.have.property('id_token').and.to.not.be.undefined;  ",
              "     decodificado = jwt_decode(json.id_token);",
              "    console.log(\"Id Token: \" + JSON.stringify(decodificado));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
